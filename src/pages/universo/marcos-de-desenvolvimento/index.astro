ge-card strong{display:block;margin:.8rem 0 .1rem;color:#ead1b5;font-family:Georgia,serif;font-size:2.5rem;font-weight:400}.wage-card p{margin:.9rem 0 0;color:#b9aeb1;font-size:.83rem;line-height:1.7}.economy-note{margin:1rem 0;color:#9f969b;font-size:.78rem;line-height:1.8}.economy-note strong{color:#c7ad9a}.subsection-title{margin:2.5rem 0 .3rem;color:#e8dbd2;font-family:Georgia,serif;font-size:1.6rem;font-weight:400}.subsection-intro{color:#b8adb0;font-size:.88rem;line-height:1.7}.table-wrap,.reward-table-wrap{overflow-x:auto;margin:1rem 0}.economy-table,.reward-table{width:100%;border-collapse:collapse;min-width:650px}.economy-table th,.reward-table th{padding:.85rem 1rem;background:#241b22;color:#c9a88e;text-align:left;font-size:.68rem;letter-spacing:.12em;text-transform:uppercase}.economy-table td,.reward-table td{padding:.85rem 1rem;border-bottom:1px solid rgba(190,151,111,.13);color:#bfb4b7;font-size:.84rem;line-height:1.6}.economy-table td strong,.reward-table td strong{color:#e7d8cd}.economy-table tbody tr:hover,.reward-table tbody tr:hover{background:rgba(255,255,255,.025)}
