---
interface Props {
  eyebrow?: string;
  title: string;
  emphasis?: string;
  /** Linha de destaque em itálico logo abaixo do título (ex.: assinatura). */
  lead?: string;
  description: string;
  meta?: string[];
  /** Variante visual (ex.: "home" para a abertura da página inicial). */
  variant?: "default" | "home";
}

const { eyebrow, title, emphasis, lead, description, meta = [], variant = "default" } = Astro.props;
---
<section class:list={["section-intro", variant === "home" && "section-intro--home"]}>
  <div class="intro-copy">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}{emphasis ? <> <em>{emphasis}</em></> : null}</h1>
    {lead && <p class="intro-lead">{lead}</p>}
    <p class="intro-description">{description}</p>
    {Astro.slots.has("actions") && (
      <div class="intro-actions">
        <slot name="actions" />
      </div>
    )}
    {meta.length > 0 && (
      <div class="intro-meta">
        {meta.map((item, index) => (
          <>
            {index > 0 && <span class="meta-divider" aria-hidden="true"></span>}
            <span>{item}</span>
          </>
        ))}
      </div>
    )}
  </div>
  {Astro.slots.has("art") && (
    <div class="intro-art" aria-hidden="true">
      <slot name="art" />
    </div>
  )}
</section>
