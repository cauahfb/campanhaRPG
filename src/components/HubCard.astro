---
import { BookOpen, FileText, FlaskConical, Hammer, Map, Network, ScrollText, Users } from "@lucide/astro";
import type { HubItem } from "../data/hub";

interface Props {
  item: HubItem;
  index: number;
}

const icons = {
  users: Users,
  network: Network,
  "scroll-text": ScrollText,
  "book-open": BookOpen,
  "flask-conical": FlaskConical,
  map: Map,
  "file-text": FileText,
  hammer: Hammer,
};

const { item, index } = Astro.props;
const Icon = icons[item.icon];
const isAvailable = item.status === "available";
const number = String(index + 1).padStart(2, "0");
const countText = item.count !== undefined ? `${item.count.toLocaleString("pt-BR")} ${item.countLabel ?? "registros"}` : null;
---
{isAvailable ? (
  <a class="section-card card-lift hub-card" href={item.href}>
    <div class="hub-card-art">
      <Icon class="hub-card-icon" aria-hidden="true" />
      <span class="hub-card-index">{number}</span>
    </div>
    <div class="hub-card-copy">
      <span class="hub-card-eyebrow">{item.eyebrow}</span>
      <h2>{item.title}</h2>
      <p>{item.description}</p>
      {countText && <span class="hub-card-status">{countText}</span>}
      <span class="hub-card-open">Entrar <span aria-hidden="true">→</span></span>
    </div>
  </a>
) : (
  <div class="section-card hub-card hub-card--soon" aria-disabled="true">
    <div class="hub-card-art">
      <Icon class="hub-card-icon" aria-hidden="true" />
      <span class="hub-card-index">{number}</span>
    </div>
    <div class="hub-card-copy">
      <span class="hub-card-eyebrow">{item.eyebrow}</span>
      <h2>{item.title}</h2>
      <p>{item.description}</p>
      <span class="hub-card-status">Em breve</span>
    </div>
  </div>
)}
