---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import "../../styles/regras.css";

const rules = [
  { slug: "overcast", title: "OverCast", category: "Magia", description: "Permite tentar conjurar mesmo depois de esgotar os espaços de magia, assumindo consequências definidas pelo Mestre.", image: "/images/regras/apresentacao/overcast.png" },
  { slug: "runomancia", title: "RunoMancia", category: "Magia", description: "Runas podem alterar, ampliar ou produzir efeitos quando são interpretadas e combinadas.", image: "/images/regras/apresentacao/runomancia.png" },
  { slug: "pocao-de-cura", title: "Poções de Cura", category: "Recursos", description: "A forma de consumir uma poção determina se a cura será máxima ou rolada.", image: "/images/regras/apresentacao/pocoes-de-cura.png" },
  { slug: "equipamento-danificado", title: "Equipamento Danificado", category: "Equipamentos", description: "Armas, armaduras e itens especiais acumulam desgaste e podem exigir reparos.", image: "/images/regras/apresentacao/equipamento-danificado.png" },
  { slug: "inspiracao", title: "Sistema de Inspiração", category: "Combate", description: "A Inspiração pode ser usada de diferentes maneiras para influenciar momentos importantes da aventura.", image: "/images/regras/apresentacao/sistema-de-inspiracao.png" },
  { slug: "flanqueamento", title: "Flanqueamento Tático", category: "Combate", description: "O posicionamento coordenado reduz a CA do alvo contra os aliados que o flanqueiam.", image: "/images/regras/apresentacao/flanqueamento.png" },
  { slug: "condicoes", title: "Condições Especiais", category: "Combate", description: "Regras específicas para os estados Atordoado e Paralisado.", image: "/images/regras/apresentacao/condicoes-especiais.png" },
  { slug: "morte-e-ressurreicao", title: "Morte e Ressurreição", category: "Sobrevivência", description: "Define como funcionam o dano além de zero pontos de vida, a morte e o retorno à vida.", image: "/images/regras/apresentacao/morte-e-ressurreicao.png" },
  { slug: "venenos", title: "Sistema de Venenos", category: "Alquimia", description: "Organiza os venenos por aplicação e origem, além de definir sua criação e neutralização.", image: "/images/regras/apresentacao/sistema-de-venenos.png" },
  { slug: "progressao-epica", title: "Progressão Épica", category: "Progressão", description: "Amplia a evolução dos personagens até o nível 30 e introduz recursos de ascensão.", image: "/images/regras/apresentacao/progressao-epica.png" },
  { slug: "promessa-velada", title: "Promessa Velada", category: "Sistemas especiais", description: "Juramentos individuais ou compartilhados trocam restrições voluntárias por benefícios.", image: "/images/regras/apresentacao/promessa-velada.png" },
];

const categories = ["Todas", "Magia", "Combate", "Recursos", "Equipamentos", "Alquimia", "Sobrevivência", "Progressão", "Sistemas especiais"];

---
<BaseLayout
  title="Regras da Casa"
  description="Consulte as regras, adaptações e sistemas utilizados na campanha."
>
  <main class="section-shell">
    <SectionIntro
      eyebrow="Compêndio da Campanha"
      title="Regras da"
      emphasis="Casa"
      description="Este é o guia das regras e dos sistemas adotados em nossa mesa. Consulte cada tema para conhecer seus efeitos, condições e exemplos de aplicação durante a aventura."
      meta={[`${rules.length} REGRAS DISPONÍVEIS`, "D&D 5ª EDIÇÃO · ADAPTAÇÕES DA CAMPANHA"]}
    >
      <div slot="art" class="intro-art-content">
        <div class="book-emblem"></div>
        <span>Conhecimento · Acordos · Consequências</span>
      </div>
    </SectionIntro>

    <section class="catalog-controls" aria-label="Busca e filtros de regras">
      <label class="search-field">
        <span class="search-icon" aria-hidden="true"></span>
        <input id="rule-search" type="search" placeholder="Buscar por nome, tema ou palavra-chave..." autocomplete="off" />
      </label>
      <div class="filter-list" role="group" aria-label="Filtrar por categoria">
        {categories.map((category, index) => (
          <button class:list={["filter-button", { "is-active": index === 0 }]} type="button" data-category={category}>{category}</button>
        ))}
      </div>
      <p class="result-count" aria-live="polite"><span id="visible-count">{rules.length}</span> regras encontradas</p>
    </section>

    <section class="rules-grid" id="rules-grid" aria-label="Regras da Casa">
      {rules.map((rule, i) => (
        <a class="section-card card-lift rule-card" href={`/regras-da-casa/${rule.slug}/`} data-category={rule.category} data-search={`${rule.title} ${rule.category} ${rule.description}`.toLocaleLowerCase("pt-BR")}>
          <div class={`rule-card-art rule-card-art--${rule.visual ?? rule.slug}`}>
            {rule.image ? <img src={rule.image} alt="" loading="lazy" /> : <span class="art-mark" aria-hidden="true"></span>}
            <span class="art-index">{String(i + 1).padStart(2, "0")}</span>
          </div>
          <div class="rule-card-copy">
            <span class="rule-category">{rule.category}</span>
            <h2>{rule.title}</h2>
            <p>{rule.description}</p>
            <span class="rule-open">Consultar regra <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
      <p class="empty-state" id="empty-state" hidden>Nenhuma regra corresponde à sua busca. Tente outro termo ou categoria.</p>
    </section>

    <SiteFooter />
  </main>
  <script>
    import { initCatalogFilter } from "../../scripts/catalog-filter";

    initCatalogFilter({
      searchSelector: "#rule-search",
      cardSelector: ".rule-card",
      filterSelector: ".filter-button",
      countSelector: "#visible-count",
      emptySelector: "#empty-state",
      filterAttribute: "data-category",
      allValue: "Todas",
    });
  </script>
</BaseLayout>
