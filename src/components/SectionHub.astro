---
import HubCard from "./HubCard.astro";
import type { HubItem } from "../data/hub";

interface Props {
  items: HubItem[];
  label?: string;
}

const { items, label = "Seções disponíveis" } = Astro.props;
---
<section class="section-hub-grid" aria-label={label}>
  {items.map((item, index) => <HubCard item={item} index={index} />)}
</section>
