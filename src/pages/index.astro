---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionIntro from "../components/SectionIntro.astro";
import SectionHub from "../components/SectionHub.astro";
import FeaturedStory from "../components/FeaturedStory.astro";
import StatsStrip from "../components/StatsStrip.astro";
import { personagens } from "../data/personagens";
import { sessoes } from "../data/sessoes";
import { destaque, estatisticas } from "../data/campanha";
import { SITE } from "../data/site";
import type { HubItem } from "../data/hub";
import "../styles/home.css";


const sessoesJogadas = estatisticas.sessoesJogadas ?? (sessoes.length > 0 ? sessoes.length : undefined);
const stats = [
  sessoesJogadas !== undefined && { value: sessoesJogadas, label: sessoesJogadas === 1 ? "sessão jogada" : "sessões jogadas" },
  estatisticas.horasJogadas !== undefined && { value: estatisticas.horasJogadas, label: "horas de mesa" },
  personagens.length > 0 && { value: personagens.length, label: personagens.length === 1 ? "personagem" : "personagens" },
].filter((item): item is { value: number; label: string } => Boolean(item));

const exploreItems: HubItem[] = [
  {
    title: "Os Corvonescos",
    description: "O grupo de aventureiros: personagens, vínculos e o diário de bordo das sessões.",
    href: "/corvonescos/",
    icon: "users",
    eyebrow: "O grupo",
    status: "available",
  },
  {
    title: "Universo",
    description: "Regiões, crônicas, documentos e tudo o que dá forma ao mundo da campanha.",
    href: "/universo/",
    icon: "map",
    eyebrow: "O mundo",
    status: "available",
  },
  {
    title: "Bestiário do Melvis",
    description: "Criaturas, ameaças e descobertas catalogadas ao longo das aventuras.",
    href: "/universo/bestiario-do-melvis/",
    icon: "book-open",
    eyebrow: "Criaturas",
    status: "available",
  },
  {
    title: "Regras da Casa",
    description: "Regras, adaptações e sistemas próprios que moldam as nossas aventuras.",
    href: "/regras-da-casa/",
    icon: "book-open",
    eyebrow: "Compêndio",
    status: "available",
  },
  {
    title: "Atividades de Downtime",
    description: "Descanso, treinamento, criação e outras escolhas entre uma aventura e outra.",
    href: "/atividades-de-downtimes/",
    icon: "scroll-text",
    eyebrow: "Tempo livre",
    status: "available",
  },
  {
    title: "Sobre Nós",
    description: "Conheça as pessoas, a história e o jeito de jogar da nossa mesa.",
    href: "/sobre-nos/",
    icon: "users",
    eyebrow: "A mesa",
    status: "available",
  },
];

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  alternateName: SITE.tagline,
  url: SITE.url,
  inLanguage: "pt-BR",
  description: SITE.defaultDescription,
};
---
<BaseLayout>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(websiteSchema)} />
  <main class="section-shell home">
    <SectionIntro
      variant="home"
      title="Campanha"
      emphasis="RPG"
      lead="Um universo além dos dados"
      description="A Campanha RPG nasceu para ser o portfólio das nossas campanhas: um só lugar para guardar o que vivemos à mesa, personagens, descobertas e histórias, e para lembrar de tudo o que o volume de conteúdo faz escapar. Um registro vivo, que cresce lado a lado com a nossa jornada."
    >
      <Fragment slot="actions">
        <a class="button button--primary" href="/corvonescos/">Conhecer Os Corvonescos <span aria-hidden="true">→</span></a>
        <a class="button button--ghost" href="/universo/">Explorar O Universo</a>
      </Fragment>
      <div slot="art" class="home-emblem">
        <img src="/images/logo/emblema-campanha-rpg.svg" alt="" width="300" height="300" decoding="async" />
      </div>
    </SectionIntro>

    {destaque && <FeaturedStory story={destaque} />}

    {stats.length >= 2 && <StatsStrip items={stats} />}

    <section class="home-section" aria-labelledby="explorar-titulo">
      <h2 class="home-section__title" id="explorar-titulo">Por onde começar</h2>
      <aside class="home-wiki-note" aria-label="Sobre o conteúdo da wiki">
        <span class="home-wiki-note__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 3.5 20 7v5c0 5-3.4 8.2-8 9.5C7.4 20.2 4 17 4 12V7l8-3.5Z" /><path d="m8.5 12 2.2 2.2 4.8-5" /></svg>
        </span>
        <p>O conteúdo acompanha o que já descobrimos na mesa, então você pode explorar sem encontrar segredos ainda por revelar.</p>
      </aside>
      <SectionHub items={exploreItems} label="Áreas do portal" />
    </section>

    <aside class="home-note home-lore-note" aria-labelledby="universo-titulo">
      <h2 id="universo-titulo">Uma versão própria de Forgotten Realms</h2>
      <p>
        O universo desta wiki é baseado em Forgotten Realms, mas foi adaptado e expandido para acompanhar a história da nossa campanha. Personagens, lugares, acontecimentos e até mesmo elementos da lore original podem, e provavelmente vão, apresentar diferenças em relação ao cânone oficial.
      </p>
      <p>
        Se você joga ou acompanha nossa mesa, considere esta wiki como a referência definitiva sobre o universo da campanha. Afinal, esta é a nossa versão de Forgotten Realms, construída e transformada ao longo da nossa jornada.
      </p>
    </aside>

  </main>
</BaseLayout>
