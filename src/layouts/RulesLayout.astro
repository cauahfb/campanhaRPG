---
import BaseLayout from "./BaseLayout.astro";
import "../styles/regras.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  frontmatter?: { title?: string; description?: string };
}

const { frontmatter, noindex } = Astro.props;
const title = Astro.props.title ?? frontmatter?.title ?? "Regras da Casa";
const description =
  Astro.props.description ?? frontmatter?.description ?? "Regras e sistemas próprios adotados na campanha.";
---
<BaseLayout title={title} description={description} noindex={noindex}>
  <slot />
</BaseLayout>
