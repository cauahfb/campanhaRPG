---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SectionIntro from "../../../components/SectionIntro.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { personagens } from "../../../data/personagens";
import "../../../styles/corvonescos.css";

const grupos = ["Ativo", "Ex-Integrante", "Falecido"] as const;
---
<BaseLayout title="Personagens | Os Corvonescos" description="Retratos e dossiês dos personagens que fizeram parte dos Corvonescos, o grupo de aventureiros da Campanha RPG.">
  <main class="section-shell">
    <Breadcrumb items={[{ label: "Os Corvonescos", href: "/corvonescos/" }, { label: "Personagens" }]} />
    <a class="back-link" href="/corvonescos/">← Voltar aos Corvonescos</a>
    <SectionIntro eyebrow="O Grupo" title="Os" emphasis="Personagens" description="Conheça os aventureiros que compõem, ou já compuseram, a história dos Corvonescos." />
    {grupos.map((status) => {
      const lista = personagens.filter((personagem) => personagem.status === status);
      return lista.length > 0 && (
        <section class="character-roster-group" aria-label={`Personagens: ${status}`}>
          <div class="character-roster-heading"><span>{status}</span><i></i></div>
          <div class="character-grid">
            {lista.map((personagem) => (
              <a class="section-card card-lift character-card" href={`/corvonescos/personagens/${personagem.slug}/`}>
                <div class="character-portrait">
                  {personagem.imagem
                    ? <img src={personagem.imagem} alt={`Retrato de ${personagem.nome}`} loading="lazy" />
                    : <span class="character-placeholder" aria-hidden="true">{personagem.nome.charAt(0)}</span>}
                </div>
                <div class="character-card-copy">
                  <span class="character-status">{personagem.status}</span>
                  <h2>{personagem.nome}</h2>
                  {personagem.classes.length > 0 && <span class="character-meta">{personagem.classes.map((classe) => classe.nome).join(" · ")}</span>}
                  <span class="character-open">Ver dossiê <span aria-hidden="true">→</span></span>
                </div>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </main>
</BaseLayout>
