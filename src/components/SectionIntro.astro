---
interface Props {
  eyebrow: string;
  title: string;
  emphasis?: string;
  description: string;
  meta?: string[];
}

const { eyebrow, title, emphasis, description, meta = [] } = Astro.props;
---
<section class="section-intro">
  <div class="intro-copy">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}{emphasis ? <> <em>{emphasis}</em></> : null}</h1>
    <p class="intro-description">{description}</p>
    {meta.length > 0 && (
      <div class="intro-meta">
        {meta.map((item, index) => (
          <>
            {index > 0 && <span class="meta-divider" aria-hidden="true"></span>}
            <span>{item}</span>
          </>
        ))}
      </div>
    )}
  </div>
  {Astro.slots.has("art") && (
    <div class="intro-art" aria-hidden="true">
      <slot name="art" />
    </div>
  )}
</section>
