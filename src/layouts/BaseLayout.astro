---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Campanha RPG — Um universo além dos dados",
  description = "Campanha RPG — nosso ponto de encontro para tudo o que nasce à mesa.",
} = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0710" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
