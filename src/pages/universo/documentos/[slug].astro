---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import DocumentoIcon from "../../../components/DocumentoIcon.astro";
import DocumentoBloco from "../../../components/DocumentoBloco.astro";
import TrackPlayer from "../../../components/TrackPlayer.astro";
import { documentos, documentosOrdenados, situacaoPorId, tipoPorId } from "../../../data/documentos";
import type { Documento } from "../../../data/documentos";
import { personagens } from "../../../data/personagens";
import { vinculos } from "../../../data/vinculos";
import { formatarInline, idDaSecao, semMarcacao } from "../../../scripts/doc-texto";
import "../../../styles/regras.css";
import "../../../styles/documentos.css";

interface Props { documento: Documento }

export function getStaticPaths() {
  return documentos.map((documento) => ({ params: { slug: documento.slug }, props: { documento } }));
}

const { documento } = Astro.props as Props;
const base = "/universo/documentos/";
const tipo = tipoPorId(documento.tipo);
const situacao = situacaoPorId(documento.situacao);
const indice = documentosOrdenados.findIndex((item) => item.slug === documento.slug);
const anterior = indice > 0 ? documentosOrdenados[indice - 1] : undefined;
const seguinte = indice < documentosOrdenados.length - 1 ? documentosOrdenados[indice + 1] : undefined;
const nomeVinculo = (slug: string) => vinculos.find((v) => v.slug === slug)?.nome ?? slug;
const faixas = documento.faixas ?? [];
const nomePersonagem = (slug: string) => personagens.find((p) => p.slug === slug)?.nome ?? slug;
const temChips = Boolean(
  (documento.locais?.length ?? 0) ||
  (documento.personagens?.length ?? 0) ||
  (documento.vinculos?.length ?? 0)
);

const ficha = [
  { rotulo: "Tipo", valor: tipo.singular },
  { rotulo: "Autoria", valor: documento.autor },
  { rotulo: "Data no mundo", valor: documento.dataNoMundo },
  { rotulo: "Idioma", valor: documento.idioma },
  { rotulo: "Origem", valor: documento.origem },
].filter((linha): linha is { rotulo: string; valor: string } => Boolean(linha.valor));

const secoes = documento.secoes ?? [];
const temSumario = secoes.filter((secao) => secao.nivel).length >= 3;
---
<BaseLayout title={`${documento.titulo} | Documentos`} description={documento.resumo} type="article">
  <main class="section-shell section-shell--detail">
    <Breadcrumb items={[{ label: "Universo", href: "/universo/" }, { label: "Documentos", href: base }, { label: documento.titulo }]} />
    <a class="back-link doc-back" href={base}>← Voltar à Biblioteca</a>

    <article class="doc-leitura">
      <header class="doc-leitura__header">
        <span class="doc-leitura__kicker">
          <DocumentoIcon name={tipo.icone} class="doc-leitura__icon" />
          {tipo.singular}
        </span>
        <h1>{documento.titulo}</h1>
        {documento.subtitulo && <p class="doc-leitura__sub">{documento.subtitulo}</p>}
      </header>

      <div class="doc-leitura__layout">
        <aside class="doc-ficha" aria-label="Ficha do documento">
          {documento.capa && (
            <img class="doc-ficha__capa" src={documento.capa} alt={`Capa de ${semMarcacao(documento.titulo)}: ${documento.subtitulo ?? ""}`.replace(/: $/, "")} width="640" loading="eager" decoding="async" />
          )}
          <div class="doc-ficha__head">
            <span>Ficha de catálogo</span>
            <span class:list={["doc-status", `doc-status--${documento.situacao}`]}>{situacao.nome}</span>
          </div>
          <dl>
            {ficha.map((linha) => (
              <div>
                <dt>{linha.rotulo}</dt>
                <dd>{linha.valor}</dd>
              </div>
            ))}
            {documento.sessao !== undefined && (
              <div>
                <dt>Sessão</dt>
                <dd><a href={`/corvonescos/diario-de-bordo/#sessao-${documento.sessao}`}>Sessão {documento.sessao} no Diário de Bordo</a></dd>
              </div>
            )}
            {documento.regra && (
              <div>
                <dt>Regra da casa</dt>
                <dd><a href={documento.regra.href}>{documento.regra.titulo}</a></dd>
              </div>
            )}
          </dl>
          {temChips && (
            <div class="doc-chips">
              {documento.locais?.map((local) => <span>{local}</span>)}
              {documento.personagens?.map((slug) => {
                const personagemRelacionado = personagens.find((personagem) => personagem.slug === slug);
                return (
                  <button
                    type="button"
                    class="doc-chip"
                    data-doc-personagem
                    data-personagem-nome={personagemRelacionado?.nome ?? nomePersonagem(slug)}
                    data-personagem-status={personagemRelacionado?.status ?? ""}
                    data-personagem-raca={personagemRelacionado?.raca ?? ""}
                    data-personagem-imagem={personagemRelacionado?.imagem ?? ""}
                    data-personagem-ficha={`/corvonescos/personagens/${slug}/`}
                  >
                    {nomePersonagem(slug)}
                  </button>
                );
              })}
              {documento.vinculos?.map((slug) => {
                const vinculoRelacionado = vinculos.find((vinculo) => vinculo.slug === slug);
                return vinculoRelacionado ? (
                  <button
                    type="button"
                    class="doc-chip"
                    data-doc-vinculo
                    data-vinculo-nome={vinculoRelacionado.nome}
                    data-vinculo-papel={vinculoRelacionado.papel}
                    data-vinculo-descricao={vinculoRelacionado.descricao ?? ""}
                    data-vinculo-localizacao={vinculoRelacionado.localizacaoInicial ?? ""}
                    data-vinculo-imagem={vinculoRelacionado.imagem ?? ""}
                    data-vinculo-nota-mestre={vinculoRelacionado.notaMestre ?? ""}
                    data-vinculo-musicas={JSON.stringify(vinculoRelacionado.musicas ?? [])}
                  >
                    {nomeVinculo(slug)}
                  </button>
                ) : null;
              })}
            </div>
          )}
          {documento.rascunho && <p class="doc-ficha__example">Rascunho: texto gerado a partir do que se sabe da campanha, a ser revisado pela mesa.</p>}
          {documento.exemplo && <p class="doc-ficha__example">Registro de exemplo: substitua pelo conteúdo real da campanha.</p>}
        </aside>

        <div class:list={["doc-folha", `doc-folha--${documento.tipo}`, documento.situacao === "destruido" && "doc-folha--destruido"]}>
          {documento.fragmento && <p class="doc-folha__tag">Fragmento</p>}

          {faixas.length > 0 && (
            <section class="doc-player" aria-label={faixas.length > 1 ? "Versões para ouvir" : "Ouvir a música"}>
              <div class="doc-player__heading">
                <span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V6l11-2v12" /><circle cx="6.5" cy="18" r="2.5" /><circle cx="17.5" cy="16" r="2.5" /></svg>
                  {faixas.length > 1 ? "Ouvir as versões" : "Ouvir"}
                </span>
                <i></i>
              </div>
              <div class="track-list">
                {faixas.map((faixa) => <TrackPlayer titulo={faixa.titulo} arquivo={faixa.arquivo} rotulo={faixa.rotulo ?? "Gravação"} subtitulo={faixa.subtitulo} tipo="cancao" />)}
              </div>
            </section>
          )}

          {temSumario && (
            <nav class="doc-sumario" aria-label="Sumário do livro">
              <p class="doc-sumario__titulo">Sumário</p>
              <ol>
                {secoes.map((secao, i) => (
                  <li class:list={[secao.nivel === 2 && "is-sub"]}>
                    <a href={`#${idDaSecao(i)}`}>{semMarcacao(secao.titulo)}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )}

          {secoes.length > 0 && (
            <div class="doc-secoes">
              {secoes.map((secao, i) => (
                <section class:list={["doc-secao", secao.nivel ? `doc-secao--n${secao.nivel}` : "doc-secao--avulsa"]} id={idDaSecao(i)}>
                  {secao.nivel === 2
                    ? <h3 class="doc-secao__titulo" set:html={formatarInline(secao.titulo)} />
                    : <h2 class="doc-secao__titulo" set:html={formatarInline(secao.titulo)} />}
                  {secao.subtitulo && <p class="doc-secao__sub">{secao.subtitulo}</p>}
                  <div class="doc-secao__corpo">
                    {secao.blocos.map((bloco) => <DocumentoBloco bloco={bloco} nivel={secao.nivel ?? 1} />)}
                  </div>
                </section>
              ))}
            </div>
          )}

          {documento.texto && documento.texto.length > 0 && (
            <div class="doc-corpo">
              {documento.texto.map((paragrafo) => (
                paragrafo.startsWith("[") && paragrafo.endsWith("]")
                  ? <p class="doc-corpo__lacuna">{paragrafo}</p>
                  : <p>{paragrafo}</p>
              ))}
            </div>
          )}

          {documento.nota && <p class="doc-nota"><strong>Nota do escriba</strong>{documento.nota}</p>}
          {documento.tipo === "musica" && (
            <p class="doc-nota doc-nota--musica">
              <strong>Nota</strong>
              <em>Esta composição foi escrita pelo Mestre e desenvolvida especialmente para esta campanha de RPG. Sua produção em áudio contou com o auxílio de ferramentas de inteligência artificial. Embora ainda não tenhamos os meios para investir em uma produção musical com músicos profissionais, esperamos que a música consiga transmitir a essência e a atmosfera que imaginamos para este universo. Quem sabe, no futuro, possamos dar a ela uma produção ainda mais especial.</em>
            </p>
          )}
        </div>
      </div>
    </article>

    {(anterior || seguinte) && (
      <nav class="doc-navegacao" aria-label="Outros documentos">
        {anterior ? <a href={`${base}${anterior.slug}/`}><small>← Anterior</small><span>{anterior.titulo}</span></a> : <span></span>}
        {seguinte ? <a class="is-next" href={`${base}${seguinte.slug}/`}><small>Seguinte →</small><span>{seguinte.titulo}</span></a> : <span></span>}
      </nav>
    )}
  </main>
  <dialog class="doc-catalog-dialog" aria-labelledby="doc-catalog-dialog-nome">
    <button class="doc-catalog-dialog-close" type="button" aria-label="Fechar detalhes">×</button>
    <div class="doc-catalog-dialog-layout">
      <div class="doc-catalog-dialog-image"><img alt="" /></div>
      <div class="doc-catalog-dialog-content">
        <span class="doc-catalog-dialog-kicker"></span>
        <h2 id="doc-catalog-dialog-nome"></h2>
        <p class="doc-catalog-dialog-subtitle"></p>
        <div class="doc-catalog-dialog-description">
          <h3>Descrição</h3>
          <p></p>
        </div>
        <div class="doc-catalog-dialog-location">
          <h3>Localização inicial</h3>
          <p></p>
        </div>
        <div class="doc-catalog-dialog-music" hidden>
          <h3>Autor de:</h3>
          <div></div>
        </div>
        <blockquote class="doc-catalog-dialog-note" hidden><span>Nota do Mestre</span><p></p></blockquote>
        <a class="doc-catalog-dialog-link" hidden>Ver ficha completa</a>
      </div>
    </div>
  </dialog>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>(".doc-catalog-dialog");
    const close = dialog?.querySelector<HTMLButtonElement>(".doc-catalog-dialog-close");
    const image = dialog?.querySelector<HTMLImageElement>(".doc-catalog-dialog-image img");
    const name = dialog?.querySelector<HTMLElement>("#doc-catalog-dialog-nome");
    const kicker = dialog?.querySelector<HTMLElement>(".doc-catalog-dialog-kicker");
    const subtitle = dialog?.querySelector<HTMLElement>(".doc-catalog-dialog-subtitle");
    const description = dialog?.querySelector<HTMLElement>(".doc-catalog-dialog-description p");
    const location = dialog?.querySelector<HTMLElement>(".doc-catalog-dialog-location p");
    const locationSection = dialog?.querySelector<HTMLElement>(".doc-catalog-dialog-location");
    const musicSection = dialog?.querySelector<HTMLElement>(".doc-catalog-dialog-music");
    const musicLinks = dialog?.querySelector<HTMLElement>(".doc-catalog-dialog-music > div");
    const note = dialog?.querySelector<HTMLElement>(".doc-catalog-dialog-note");
    const link = dialog?.querySelector<HTMLAnchorElement>(".doc-catalog-dialog-link");

    const openDialog = (source: HTMLElement, tipo: "vinculo" | "personagem"): void => {
      if (!dialog || !image || !name || !kicker || !subtitle || !description || !location || !locationSection) return;

      name.textContent = source.dataset[tipo === "vinculo" ? "vinculoNome" : "personagemNome"] ?? "";
      kicker.textContent = tipo === "vinculo" ? "Ficha de vínculo" : "Ficha de personagem";
      subtitle.textContent = tipo === "vinculo"
        ? source.dataset.vinculoPapel ?? ""
        : [source.dataset.personagemStatus, source.dataset.personagemRaca].filter(Boolean).join(" · ");
      description.textContent = tipo === "vinculo"
        ? source.dataset.vinculoDescricao || "Descrição ainda não registrada."
        : "Ficha completa do personagem dos Corvonescos.";

      const imagem = tipo === "vinculo" ? source.dataset.vinculoImagem : source.dataset.personagemImagem;
      if (imagem) {
        image.src = imagem;
        image.alt = name.textContent ?? "";
        image.parentElement?.removeAttribute("hidden");
      } else {
        image.removeAttribute("src");
        image.alt = "";
        image.parentElement?.setAttribute("hidden", "");
      }

      if (tipo === "vinculo") {
        locationSection.hidden = false;
        location.textContent = source.dataset.vinculoLocalizacao || "Localização inicial ainda não registrada.";
        if (note) {
          if (source.dataset.vinculoNotaMestre) {
            note.hidden = false;
            const noteText = note.querySelector<HTMLElement>("p");
            if (noteText) noteText.textContent = source.dataset.vinculoNotaMestre;
          } else {
            note.hidden = true;
          }
        }
        if (musicSection && musicLinks) {
          const musicas = JSON.parse(source.dataset.vinculoMusicas ?? "[]") as { titulo: string; slug: string }[];
          musicLinks.replaceChildren();
          if (musicas.length > 0) {
            musicSection.hidden = false;
            musicas.forEach((musica) => {
              const musicLink = document.createElement("a");
              musicLink.href = `/universo/documentos/${musica.slug}/`;
              musicLink.textContent = musica.titulo;
              musicLinks.append(musicLink);
            });
          } else {
            musicSection.hidden = true;
          }
        }
      } else {
        locationSection.hidden = true;
        if (note) note.hidden = true;
        if (musicSection) musicSection.hidden = true;
      }

      if (link) {
        const ficha = tipo === "vinculo" ? "" : source.dataset.personagemFicha;
        if (ficha) {
          link.href = ficha;
          link.hidden = false;
        } else {
          link.removeAttribute("href");
          link.hidden = true;
        }
      }
      dialog.showModal();
    };

    document.querySelectorAll<HTMLElement>("[data-doc-vinculo]").forEach((button) => {
      button.addEventListener("click", () => openDialog(button, "vinculo"));
    });
    document.querySelectorAll<HTMLElement>("[data-doc-personagem]").forEach((button) => {
      button.addEventListener("click", () => openDialog(button, "personagem"));
    });
    close?.addEventListener("click", () => dialog?.close());
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  </script>
</BaseLayout>
